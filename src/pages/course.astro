---
import Base from '../layouts/Base.astro';
import { COURSE_CONTACT } from '../data/site';

const courseWhatsapp = COURSE_CONTACT.whatsapp;
const courseEmail = COURSE_CONTACT.email;

const courseName = 'שותפות הורים בתהליך הטיפולי';
const courseSubtitle = 'מתיאוריה לפרקטיקה בקליניקה';
const courseDescription = 'קורס דיגיטלי למטפלות: איך הופכים את ההורים מצופים מהצד לסוכני השינוי המרכזיים בבית.';

const courseLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: courseName,
  description: courseDescription,
  inLanguage: 'he',
  provider: [
    { '@type': 'Person', name: 'רוני אליאב' },
    { '@type': 'Person', name: 'בתיה אהרן פלזן' },
  ],
  offers: { '@type': 'Offer', price: '350', priceCurrency: 'ILS' },
};
---
<Base title={courseName} description={courseDescription}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(courseLd)} />

  <section class="hero">
    <div class="container">
      <h1>{courseName}</h1>
      <p><strong>{courseSubtitle}</strong></p>
      <p>הורים הם לא הקהל של הטיפול שלך, הם הלב שלו. {courseDescription}</p>
      <a class="btn" href={courseWhatsapp}>להרשמה בווטסאפ</a>
      &nbsp;
      <a class="btn btn-outline" href={courseEmail}>להרשמה במייל</a>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>למי הקורס מתאים</h2>
      <p class="lead">לכל מי שמכירה את הרגע שבו הטיפול בקליניקה מתקדם נפלא, אבל כשהילד חוזר הביתה הדברים נתקעים, וההורים נשארים "צופים מהצד".</p>
      <div class="grid">
        <div class="card"><h3>מרפאות בעיסוק</h3><p>שרוצות להעמיק את העבודה עם ההורים ולהפוך אותם לשותפים לדרך.</p></div>
        <div class="card"><h3>קלינאיות תקשורת</h3><p>שמחפשות כלים מעשיים לגייס את ההורים להמשך העבודה בבית.</p></div>
        <div class="card"><h3>מטפלות רגשיות</h3><p>שרוצות לבנות עם ההורים שיתוף פעולה מכיל, קשוב וללא שיפוטיות.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>מה תלמדו</h2>
      <ul class="checklist">
        <li>להפוך את ההורים מצופים מהצד לסוכני השינוי המרכזיים בבית</li>
        <li>לקבוע יחד עם ההורים מטרות טיפול משמעותיות</li>
        <li>לגייס מוטיבציה פנימית, בעזרת עקרונות האימון (coaching)</li>
        <li>להציב גבולות מבוססי התקשרות (ACT), ולעזור להורים להחזיק אותם בבית</li>
      </ul>
      <h2>מבנה הקורס</h2>
      <ul class="checklist">
        <li>4 מפגשים מוקלטים, ממוקדים, מעשיים וחווייתיים, לצפייה מכל מקום ובכל זמן</li>
        <li>חוברת עבודה דיגיטלית: מדריך יישומי לשיתוף הורים בקליניקה</li>
        <li>זמינות מלאה שלנו לכל שאלה והתייעצות קלינית לאורך הלמידה</li>
      </ul>
      <p><strong>מחיר הקורס המלא: 350 ₪.</strong> כדי להירשם, שלחו לנו הודעה בווטסאפ או במייל, ונשלח לכם את אפשרויות התשלום.</p>
      <h2>על המנחות</h2>
      <p><strong>רוני אליאב</strong>, מרפאה בעיסוק, מטפלת מוסמכת בשיטת Cog-Fun ובעלת תואר שני בייעוץ והדרכת הורים. מלווה הורים וילדים כבר שנים, ומדריכה מרפאות בעיסוק בהדרכה אישית ובהדרכת צוותים. הדרכה היא עבורה תשוקה גדולה, ומקום שבו היא לומדת ומלמדת בו־זמנית.</p>
      <p><strong>בתיה אהרן פלזן</strong>, מרפאה בעיסוק ומטפלת CBT, רכזת ריפוי בעיסוק בקופת חולים מאוחדת. שותפתה של רוני לקורס ולפודקאסט "ריפוי בעיסוק בגובה העיניים".</p>
      <p style="text-align:center; margin-top:40px">
        <a class="btn" href={courseWhatsapp}>אני רוצה להצטרף, בווטסאפ</a>
        &nbsp;
        <a class="btn btn-outline" href={courseEmail}>או במייל</a>
      </p>
    </div>
  </section>
</Base>
