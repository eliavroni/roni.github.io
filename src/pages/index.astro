---
import Base from '../layouts/Base.astro';
import { SITE, CONTACT } from '../data/site';

const services = [
  {
    title: 'הדרכת הורים',
    text: 'כלים מעשיים להבנת הילד, להתמודדות עם אתגרים יומיומיים ולחיזוק הקשר בבית.',
  },
  {
    title: 'ויסות רגשי',
    text: 'עבודה עם ילדים והורים על זיהוי רגשות, הרגעה עצמית והתמודדות עם מצבי תסכול.',
  },
  {
    title: 'ילדים עם ADHD בשיטת Cog-Fun',
    text: 'טיפול ממוקד בתפקודים ניהוליים דרך משחק ופעילות, בשיתוף ההורים, על ידי מטפלת מוסמכת בשיטה.',
  },
  {
    title: 'מבוגרים עם ADHD, אונליין',
    text: 'ליווי אישי מהבית: ניהול זמן, התארגנות ואסטרטגיות שמתאימות לחיים שלך.',
  },
  {
    title: 'הכשרות למרפאות בעיסוק',
    text: 'הדרכה אישית למרפאות בעיסוק, וקורס דיגיטלי למטפלות על שותפות הורים בתהליך הטיפולי.',
    link: '/course',
  },
];
---
<Base>
  <section class="hero">
    <div class="container">
      <h1 class="hero-logo"><img src="/images/logo.png" width="1200" height="455" alt="רוני אליאב, מרפאה בעיסוק ומדריכת הורים" /></h1>
      <p>ליווי ילדים, הורים ומבוגרים עם ADHD, הדרכת הורים וויסות רגשי, בגישה חמה, מעשית ומותאמת אישית.</p>
      <a class="btn" href="#contact">לתיאום שיחת היכרות</a>
    </div>
  </section>

  <section id="services" class="section section-alt">
    <div class="container">
      <h2>במה אני יכולה לעזור</h2>
      <p class="lead">כל תהליך מתחיל בשיחת היכרות, כדי להבין מה חשוב לכם ולהתאים את הדרך.</p>
      <div class="grid">
        {services.map((s) => (
          <div class="card">
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            {s.link && <p class="more"><a href={s.link}>לפרטים על הקורס ←</a></p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="about" class="section">
    <div class="container prose">
      <img class="about-photo" src="/images/blog/roni-portrait.jpg" alt="רוני אליאב" width="160" height="160" />
      <h2>נעים מאוד, אני רוני</h2>
      <p>אני מרפאה בעיסוק, מטפלת מוסמכת בשיטת Cog-Fun (הכשרת האוניברסיטה העברית) ובעלת תואר שני בייעוץ והדרכת הורים מאוניברסיטת חיפה. במשך שנים ליוויתי ילדים והורים בקליניקה הפרטית שלי ברחובות, הנחיתי סדנאות משחק להורים, וליוויתי אימהות בכניסה להורות במחלקת אשפוז יום הורה–תינוק בבית החולים "מרחבים".</p>
      <p>כשנכנסתי לעולם הריפוי בעיסוק, תהיתי לפעמים מה אני כבר עושה, הרי אני "רק משחקת עם הילד". בהדרגה הבנתי שהכוח הגדול של המקצוע הזה טמון בקשר: אותו חיבור שמגייס מוטיבציה, מעודד התקדמות ויוצר שינוי אמיתי. וכשנולדתי כאמא, הבנתי כמה מורכבת ההורות, ושהקשר המיוחד הזה צריך לעבור גם אל הקשר שבין הילד להוריו. לכן המטרה שלי היא לא רק ללמד את הילד, אלא ללמד במקביל את ההורה: לעזור לכם לראות את הילד דרך עיניים של מסוגלות, ולהוביל אותו לעשייה ולהצלחה.</p>
      <h3>האני מאמין שלי</h3>
      <ul class="checklist">
        <li><strong>להסתכל מעבר להתנהגות:</strong> לא להיבהל מהתנגדות או מתסכול, לעצור ולהבין מה הילד באמת מבקש מאיתנו עכשיו.</li>
        <li><strong>הורות כשותפות:</strong> ההורים הם לא הקהל של הטיפול, הם הלב שלו. אני עובדת אתכם בגישה מכילה, קשובה וללא שיפוטיות.</li>
        <li><strong>לראות את הילד השלם:</strong> את הגוף, התקשורת, הרגש ועולם התוכן שמעניין אותו, ולא רק את הקושי.</li>
        <li><strong>לסמוך על הדרך:</strong> טיפול הוא תהליך עמוק, שלא תמיד הולך לפי מה שכתוב במחברת, וזה בסדר.</li>
      </ul>
      <p>היום אני גרה בדנמרק, וכל המפגשים מתקיימים אונליין, בזום: עם הורים, ילדים ומבוגרים עם ADHD. לצד העבודה עם משפחות אני מדריכה מרפאות בעיסוק בהדרכה אישית ובהדרכת צוותים, ויחד עם בתיה אהרן פלזן אני מגישה את הפודקאסט "ריפוי בעיסוק בגובה העיניים".</p>
    </div>
  </section>

  <section id="contact" class="section section-alt">
    <div class="container prose" style="text-align:center">
      <h2>בואו נדבר</h2>
      <p class="lead" style="margin-inline:auto">אפשר לכתוב לי בווטסאפ או במייל, ואחזור אליכם בהקדם.</p>
      <p>
        <a class="btn" href={CONTACT.whatsapp}>ווטסאפ</a>
        &nbsp;
        <a class="btn btn-outline" href={CONTACT.email}>מייל</a>
      </p>
    </div>
  </section>
</Base>
